@{
    Layout = "_Layout";
    ViewData["Title"] = "Search Medicines";
}

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .medicine-card {
            transition: transform 0.2s ease;
            cursor: pointer;
            border: 1px solid #edf2f7;
            border-radius: 8px;
        }

            .medicine-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            }

        .med-img {
            height: 160px;
            object-fit: contain;
            background: #f8fafc;
            padding: 15px;
        }
    </style>
}

<div class="container py-4">
    <div class="card p-4 bg-white border-0 shadow-sm mb-4">
        <h4 class="fw-bold mb-2">Search Medicines</h4>
        <input type="text" id="searchInput" class="form-control form-control-lg"
               placeholder="Search by name or generic..." />
    </div>

    <h5 class="fw-bold mb-3 text-secondary">Available Products</h5>
    <div class="row g-4" id="medicineGrid"></div>
</div>

@section Scripts {
    <script>
        function loadMedicines(query) {
            $.get('/Home/GetMedicines', { q: query }, function (data) {
                var grid = $('#medicineGrid');
                grid.empty();

                if (data.length === 0) {
                    grid.html('<p class="text-muted">No medicines found.</p>');
                    return;
                }

                $.each(data, function (i, item) {
                    var imgSrc = item.imageUrl || 'https://via.placeholder.com/300x200?text=' + encodeURIComponent(item.name);
                    var card = `
                        <div class="col-md-3">
                            <div class="card h-100 medicine-card" onclick="location.href='/Medicine/Details/${item.id}'">
                                <img src="${imgSrc}" class="card-img-top med-img" onerror="this.src='https://via.placeholder.com/300x200?text=Medicine'">
                                <div class="card-body d-flex flex-column">
                                    <h6 class="fw-bold mb-1">${item.name}</h6>
                                    <p class="small text-muted mb-2">${item.genericName}</p>
                                    <div class="mt-auto d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary">Rs. ${item.price}</span>
                                        <small class="text-muted">Stock: ${item.stock}</small>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                    grid.append(card);
                });
            });
        }

        $('#searchInput').on('keyup', function () {
            loadMedicines($(this).val());
        });

        $(document).ready(function () {
            loadMedicines('');
        });
    </script>
}